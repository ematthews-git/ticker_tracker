# Reddit API Credentials
# Get these from https://www.reddit.com/prefs/apps
# 1. Go to https://www.reddit.com/prefs/apps
# 2. Click "create another app..." or "create app"
# 3. Fill in:
#    - Name: ticker_tracker (or any name)
#    - App type: script
#    - Description: (optional)
#    - About URL: (leave blank)
#    - Redirect URI: http://localhost:8080 (required but not used for script apps)
# 4. After creating, you'll see:
#    - client_id: The string under your app name (looks like: A4H9MeTjy52k5sdpvA7-rg)
#    - client_secret: The "secret" field (looks like: F_QaKFJRnO5WQK9QSnTb0aG_hVHNwg)
REDDIT_CLIENT_ID=A4H9MeTjy52k5sdpvA7-rg
REDDIT_CLIENT_SECRET=F_QaKFJRnO5WQK9QSnTb0aG_hVHNwg
REDDIT_USER_AGENT=ticker_tracker by u/valk3isthebest

# Database Configuration
DATABASE_PATH="data.db"

